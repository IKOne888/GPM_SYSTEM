/* pages/course/list.wxss - 课程中心 */

.page-course-list {
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input-wrap {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

.search-input {
  font-size: 28rpx;
  height: 50rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  padding: 16rpx 30rpx;
  background: #fff;
  margin-bottom: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filter-item {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.filter-item.active {
  background: #1890ff;
  color: #fff;
}

/* 课程卡片 */
.course-card {
  margin-bottom: 20rpx;
}

.course-head {
  margin-bottom: 16rpx;
}

.course-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.course-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.meta-chip {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin-right: 14rpx;
  margin-bottom: 10rpx;
}

.course-code {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
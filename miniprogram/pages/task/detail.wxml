<!--pages/task/detail.wxml - 任务详情-->
<view class="page-task-detail" wx:if="{{task}}">
  <!-- 任务概要 -->
  <view class="detail-header card">
    <view class="detail-title-row flex-between">
      <text class="detail-title">{{task.courseName || task.name || '培训课程'}}</text>
      <text class="tag {{task.statusClass}}">{{task.statusText}}</text>
    </view>
    <!-- 审核进度与退回意见提示（进入两级审核链后展示） -->
    <view class="review-tip" wx:if="{{task.reviewStatusText}}">
      <text class="review-tip-text">审核进度：{{task.reviewStatusText}}</text>
    </view>
    <view class="review-tip review-tip-error" wx:if="{{task.rejectRemark}}">
      <text class="review-tip-text">退回意见：{{task.rejectRemark}}</text>
    </view>
    <view class="detail-meta">
      <view class="meta-item" wx:if="{{task.courseCode}}">
        <text class="meta-label">课程编码</text>
        <text class="meta-value">{{task.courseCode}}</text>
      </view>
      <view class="meta-item" wx:if="{{task.sopCode}}">
        <text class="meta-label">SOP编号</text>
        <text class="meta-value">{{task.sopCode}} {{task.sopVersion || ''}}</text>
      </view>
      <view class="meta-item" wx:if="{{task.trainingHours}}">
        <text class="meta-label">培训学时</text>
        <text class="meta-value">{{task.trainingHours}}学时</text>
      </view>
      <view class="meta-item" wx:if="{{task.passScore}}">
        <text class="meta-label">及格分</text>
        <text class="meta-value">{{task.passScore}}分</text>
      </view>
    </view>
  </view>

  <!-- 培训目标 -->
  <view class="section card" wx:if="{{task.trainingObjective}}">
    <view class="section-title">培训目标</view>
    <text class="section-content">{{task.trainingObjective}}</text>
  </view>

  <!-- 任务信息 -->
  <view class="section card">
    <view class="section-title">任务信息</view>
    <view class="info-grid">
      <view class="info-item" wx:if="{{task.planName}}">
        <text class="info-label">所属计划</text>
        <text class="info-value ellipsis">{{task.planName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">截止时间</text>
        <text class="info-value {{task.status === 'overdue' ? 'text-danger' : ''}}">{{task.deadlineText || '无'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">学习时长</text>
        <text class="info-value">{{task.studyDurationText || '0秒'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">视频进度</text>
        <text class="info-value">{{task.progressPercent}}%</text>
      </view>
      <view class="info-item" wx:if="{{task.examScore !== null && task.examScore !== undefined}}">
        <text class="info-label">考试成绩</text>
        <text class="info-value {{task.examPass === 1 ? 'text-success' : 'text-danger'}}">{{task.examScore}}分</text>
      </view>
    </view>

    <!-- 任务说明 -->
    <view class="task-desc" wx:if="{{task.description}}">
      <text class="info-label">任务说明</text>
      <text class="section-content">{{task.description}}</text>
    </view>

    <!-- 总进度条 -->
    <view class="detail-progress" wx:if="{{task.status === 'studying' || task.status === 'waiting_exam'}}">
      <view class="progress-bar-wrap">
        <view class="progress-bar" style="width: {{task.progressPercent}}%"></view>
      </view>
      <text class="progress-text">总进度 {{task.progressPercent}}%</text>
    </view>
  </view>

  <!-- 视频课件列表 -->
  <view class="section card">
    <view class="section-title">视频课件 ({{videoList.length}})</view>
    <view class="video-list">
      <view
        wx:for="{{videoList}}"
        wx:key="id"
        class="video-item"
        data-id="{{item.id}}"
        bindtap="onVideoTap"
      >
        <view class="video-index">{{index + 1}}</view>
        <view class="video-info flex-1">
          <text class="video-name ellipsis">{{item.name}}</text>
          <text class="video-duration">{{item.durationText}}{{item.isCompleted === 1 ? ' · 已完成' : (item.progressPercent > 0 ? ' · 已学' + item.progressPercent + '%' : '')}}</text>
        </view>
        <view class="video-play-icon">▶</view>
      </view>
      <view class="empty-text" wx:if="{{videoList.length === 0}}">暂无视频课件</view>
    </view>
  </view>

  <!-- 课程资料 -->
  <view class="section card" wx:if="{{fileList.length > 0}}">
    <view class="section-title">课程资料 ({{fileList.length}})</view>
    <view class="video-list">
      <view
        wx:for="{{fileList}}"
        wx:key="id"
        class="video-item"
        data-id="{{item.id}}"
        bindtap="onFileTap"
      >
        <view class="video-index">{{item.fileType || '资料'}}</view>
        <view class="video-info flex-1">
          <text class="video-name ellipsis">{{item.name}}</text>
          <text class="video-duration">{{item.fileSizeText}}</text>
        </view>
        <view class="video-play-icon">⬇</view>
      </view>
    </view>
  </view>

  <!-- 考试信息 -->
  <view class="section card" wx:if="{{exam}}">
    <view class="section-title">考试信息</view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">试卷名称</text>
        <text class="info-value ellipsis">{{exam.paperName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">考试时长</text>
        <text class="info-value">{{exam.duration}}分钟</text>
      </view>
      <view class="info-item">
        <text class="info-label">题目数量</text>
        <text class="info-value">{{exam.questionCount}}题</text>
      </view>
      <view class="info-item">
        <text class="info-label">剩余次数</text>
        <text class="info-value">{{exam.remainRetry}}/{{exam.maxRetry}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <!-- 待学习 / 学习中：去学习 -->
    <button
      class="btn-primary action-btn"
      wx:if="{{task.status === 'not_started' || task.status === 'studying'}}"
      bindtap="onStartStudy"
    >
      {{task.status === 'not_started' ? '开始学习' : '继续学习'}}
    </button>
    <!-- 待考试：去考试 -->
    <button
      class="btn-primary action-btn exam-btn"
      wx:if="{{task.status === 'waiting_exam'}}"
      bindtap="onGoExam"
    >
      去考试
    </button>
    <!-- 已完成 -->
    <view class="action-done" wx:if="{{task.status === 'completed'}}">
      <text class="done-icon">✔</text>
      <text class="done-text">培训已完成</text>
    </view>
  </view>
</view>
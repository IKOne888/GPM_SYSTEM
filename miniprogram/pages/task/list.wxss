/* pages/task/list.wxss */

.page-task-list {
  padding-bottom: 30rpx;
}

.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input-wrap {
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

.search-input {
  font-size: 28rpx;
  height: 50rpx;
}

.filter-bar {
  display: flex;
  padding: 16rpx 30rpx;
  background: #fff;
  margin-bottom: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-top: 1rpx solid #f0f0f0;
}

.filter-item {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.filter-item.active {
  background: #1890ff;
  color: #fff;
}

.task-card {
  margin-bottom: 20rpx;
}

.task-card-header {
  margin-bottom: 16rpx;
}

.task-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.task-card-body {
  margin-bottom: 10rpx;
}

.task-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-label {
  color: #999;
  font-size: 24rpx;
  flex-shrink: 0;
}

.info-value {
  color: #666;
  font-size: 24rpx;
}

.text-danger {
  color: #ff4d4f !important;
}

.task-progress-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.progress-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #1890ff, #36cfc9);
  border-radius: 6rpx;
}

.progress-text {
  color: #1890ff;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

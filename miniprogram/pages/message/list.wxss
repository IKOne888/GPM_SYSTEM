/* pages/message/list.wxss - 消息中心 */

.page-message {
  padding-bottom: 30rpx;
}

/* 工具栏 */
.msg-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.msg-filter {
  display: flex;
}

.filter-item {
  padding: 8rpx 26rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  margin-right: 16rpx;
}

.filter-item.active {
  background: #1890ff;
  color: #fff;
}

.read-all {
  font-size: 26rpx;
  color: #1890ff;
}

/* 消息卡片 */
.msg-list {
  padding-top: 20rpx;
}

.msg-card {
  margin-bottom: 20rpx;
}

/* 未读消息左侧标记 */
.msg-unread {
  border-left: 8rpx solid #1890ff;
}

.msg-head {
  margin-bottom: 14rpx;
}

.msg-type-wrap {
  display: flex;
  align-items: center;
}

.msg-type {
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

/* 未读红点 */
.msg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  margin-left: 12rpx;
}

.msg-time {
  font-size: 22rpx;
  color: #999;
}

.msg-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.msg-content {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
}
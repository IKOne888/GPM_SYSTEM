/* pages/demand/submit.wxss - 提交培训需求 */

.page-demand-submit {
  padding: 20rpx 30rpx 60rpx;
}

/* 提示条 */
.tip-bar {
  background: #e6f7ff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #1890ff;
  line-height: 1.5;
}

/* 表单卡片 */
.form-card {
  padding: 30rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
  position: relative;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 14rpx;
}

.required {
  color: #ff4d4f;
  margin-left: 6rpx;
}

.form-input {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  height: 50rpx;
}

.form-textarea {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
}

/* 字数统计 */
.form-count {
  align-self: flex-end;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-wrap {
  margin-top: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 44rpx;
}
/* pages/profile/certificate.wxss - 培训档案 / 证书 */

.page-certificate {
  padding-bottom: 30rpx;
}

.cert-list {
  padding-top: 20rpx;
}

/* 证书卡片（左侧色条按状态区分） */
.cert-card {
  margin-bottom: 20rpx;
  border-left: 10rpx solid #52c41a;
}

.cert-card.cert-valid {
  border-left-color: #52c41a;
}

.cert-card.cert-expiring {
  border-left-color: #fa8c16;
}

.cert-card.cert-expired {
  border-left-color: #ff4d4f;
}

.cert-card.cert-notpass {
  border-left-color: #bfbfbf;
}

/* 头部 */
.cert-head {
  margin-bottom: 20rpx;
}

.cert-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.cert-status {
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background: #f6ffed;
  color: #52c41a;
  flex-shrink: 0;
}

.cert-expiring .cert-status {
  background: #fff7e6;
  color: #fa8c16;
}

.cert-expired .cert-status {
  background: #fff1f0;
  color: #ff4d4f;
}

.cert-notpass .cert-status {
  background: #f5f5f5;
  color: #999;
}

/* 元信息网格 */
.cert-meta {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.meta-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  margin-bottom: 14rpx;
}

.meta-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #666;
}

/* 通过信息 */
.cert-body {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cert-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.cert-label {
  font-size: 26rpx;
  color: #999;
}

.cert-value {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.text-success {
  color: #52c41a !important;
}

.text-warning {
  color: #fa8c16 !important;
}

.text-danger {
  color: #ff4d4f !important;
}

/* 未通过提示 */
.cert-notpass-tip {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cert-notpass-tip text {
  font-size: 26rpx;
  color: #999;
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
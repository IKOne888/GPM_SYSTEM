<!--pages/profile/index.wxml - 个人中心-->
<view class="page-profile">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="avatar">{{avatarText}}</view>
    <view class="user-info">
      <text class="user-name">{{profile.realName || profile.username || '员工'}}</text>
      <text class="user-account">账号：{{profile.username}}</text>
      <text class="user-login" wx:if="{{profile.lastLoginTimeText}}">最近登录：{{profile.lastLoginTimeText}}</text>
    </view>
  </view>

  <!-- 个人资料 -->
  <view class="section card">
    <view class="section-head flex-between">
      <text class="section-title">个人资料</text>
      <text class="section-action" bindtap="onEditProfile">编辑</text>
    </view>
    <view class="info-row">
      <text class="info-label">用户名</text>
      <text class="info-value">{{profile.username || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">真实姓名</text>
      <text class="info-value">{{profile.realName || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">手机号</text>
      <text class="info-value">{{profile.phone || '未填写'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">邮箱</text>
      <text class="info-value">{{profile.email || '未填写'}}</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section card menu-card">
    <view class="menu-item" bindtap="onGoRecord">
      <text class="menu-icon">📋</text>
      <text class="menu-text">学习记录 / 成绩单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoCertificate">
      <text class="menu-icon">🏅</text>
      <text class="menu-text">培训档案 / 证书</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoDemand">
      <text class="menu-icon">📝</text>
      <text class="menu-text">培训需求申报</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onGoMessage">
      <text class="menu-icon">✉</text>
      <text class="menu-text">消息中心</text>
      <text class="badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 账号安全 -->
  <view class="section card menu-card">
    <view class="menu-item" bindtap="onEditPassword">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-wrap">
    <button class="btn-danger logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <!-- 修改资料弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">修改个人资料</view>
      <view class="modal-form">
        <view class="modal-item">
          <text class="modal-label">手机号</text>
          <input class="modal-input" placeholder="请输入手机号" value="{{editForm.phone}}" bindinput="onPhoneInput" type="number" maxlength="11" />
        </view>
        <view class="modal-item">
          <text class="modal-label">邮箱</text>
          <input class="modal-input" placeholder="请输入邮箱" value="{{editForm.email}}" bindinput="onEmailInput" />
        </view>
      </view>
      <view class="modal-btns">
        <button class="btn-secondary modal-btn" bindtap="onCloseEditModal">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSubmitProfile">保存</button>
      </view>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view class="modal-mask" wx:if="{{showPwdModal}}" bindtap="onClosePwdModal">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">修改密码</view>
      <view class="modal-form">
        <view class="modal-item">
          <text class="modal-label">原密码</text>
          <input class="modal-input" password="{{true}}" placeholder="请输入原密码" value="{{pwdForm.oldPassword}}" bindinput="onOldPwdInput" />
        </view>
        <view class="modal-item">
          <text class="modal-label">新密码</text>
          <input class="modal-input" password="{{true}}" placeholder="6-20位，含字母和数字" value="{{pwdForm.newPassword}}" bindinput="onNewPwdInput" />
        </view>
        <view class="modal-item">
          <text class="modal-label">确认密码</text>
          <input class="modal-input" password="{{true}}" placeholder="请再次输入新密码" value="{{pwdForm.confirmPassword}}" bindinput="onConfirmPwdInput" />
        </view>
      </view>
      <view class="modal-btns">
        <button class="btn-secondary modal-btn" bindtap="onClosePwdModal">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSubmitPassword">确认修改</button>
      </view>
    </view>
  </view>
</view>